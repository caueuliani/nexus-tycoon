<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />
    <queries>
        <intent tools:node="remove">
            <action android:name="com.android.vending.billing.InAppBillingService.BIND" />
        </intent>
        <intent tools:node="remove">
            <action android:name="com.google.android.apps.play.billingtestcompanion.BillingOverrideService.BIND" />
        </intent>
        <package android:name="com.android.vending" tools:node="remove" />
    </queries>
    <application>
        <meta-data android:name="com.google.android.play.billingclient.version" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" tools:node="remove" />
        <activity android:name="com.google.android.libraries.ads.mobile.sdk.common.AdActivity" tools:node="remove" />
        <activity android:name="com.android.billingclient.api.ProxyBillingActivity" tools:node="remove" />
        <activity android:name="com.android.billingclient.api.ProxyBillingActivityV2" tools:node="remove" />
    </application>
</manifest>
